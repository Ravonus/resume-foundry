# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Better Auth
# Secret used by Better Auth
BETTER_AUTH_SECRET=""

# Better Auth Google OAuth
BETTER_AUTH_GOOGLE_CLIENT_ID=""
BETTER_AUTH_GOOGLE_CLIENT_SECRET=""

# Drizzle
DATABASE_URL="postgresql://postgres:password@localhost:5432/resume-build"

# Eden AI (optional - provider/model default to openai/gpt-4o, OCR defaults to google)
EDENAI_API_KEY=""
EDENAI_PROVIDER=""
EDENAI_MODEL=""
EDENAI_OCR_PROVIDER=""
EDENAI_DEBUG="false"
EDENAI_DEBUG_VERBOSE="false"
EDENAI_MAX_PROMPT_CHARS="12000"
EDENAI_MAX_TOKENS="500"
AI_LOG_ENABLED="false"
AI_LOG_LEVEL="info"
AI_LOG_DIR="logs"
AI_LOG_FILE="ai-calls.jsonl"
AI_LOG_VERBOSE="false"

# LinkedIn Scraper (optional, defaults to http://localhost:5150)
LINKEDIN_SCRAPER_URL=""
LINKEDIN_SCRAPER_API_KEY=""
LINKEDIN_SCRAPER_TIMEOUT_MS="20000"
LINKEDIN_EXTRACT_MULTI="false"
SCRAPER_ADMIN_TOKEN=""5

# Site generator
SITE_GENERATOR_JOBS_URL="http://localhost:3814/jobs"
SITE_GENERATOR_TEMPLATE_PATH="/mnt/c/Users/chadk/Documents/resume-agent/resume"
SITE_GENERATOR_RESUME_MARKDOWN_PATH="public/resume/resume.md"
SITE_GENERATOR_PROMPT="Create a bold one-page portfolio with strong typography, high-contrast colors, and tasteful motion for a senior product designer."
SITE_GENERATOR_ADMIN_BASE_URL="https://admin.mog.garden"
SITE_GENERATOR_ORGANIZATION_ID="cmkaxz9zm00013t99nlhos4k4"
SITE_GENERATOR_DOMAIN_BASE="mog.garden"
SITE_GENERATOR_REPO_PROVIDER="gitea"
SITE_GENERATOR_GITEA_BASE_URL="https://gitea.mog.garden"
SITE_GENERATOR_DEFAULT_BRANCH="main"
SITE_GENERATOR_BUILD_COMMAND="pnpm build"
SITE_GENERATOR_DEPLOY_MODE="server"
NEXT_PUBLIC_SITE_DOMAIN_BASE="mog.garden"
